rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  match /users/{uid}/{document=**} { allow read, write: if signed() && request.auth.uid == uid; }
  match /invites/{inviteId} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && request.resource.data.keys().hasOnly(['tripId','ownerId']) && request.resource.data.ownerId == request.auth.uid && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId == request.auth.uid;
   allow update: if signed() && resource.data.ownerId == request.auth.uid && request.resource.data.keys().hasOnly(['tripId','ownerId']) && request.resource.data.ownerId == resource.data.ownerId && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId == resource.data.ownerId;
   allow delete: if signed() && resource.data.ownerId == request.auth.uid;
  }
  match /trips/{tripId} {
   function owner() { return signed() && resource.data.ownerId == request.auth.uid; }
   function member() { return signed() && request.auth.uid in resource.data.memberIds; }
   function joining() {
    let uid = request.auth.uid;
    let before = resource.data;
    let after = request.resource.data;
    return !(uid in before.memberIds)
      && before.inviteId is string
      && (!('inviteExpiresAt' in before) || request.time.toMillis() < before.inviteExpiresAt)
      && before.memberIds.size() < 20
      && after.members[uid].keys().hasOnly(['name','joinedAt'])
      && after.members[uid].name is string && after.members[uid].name.size() <= 40
      && after.diff(before).affectedKeys().hasOnly(['members','memberIds','joinInvite'])
      && after.joinInvite == before.inviteId
      && after.memberIds.size() == before.memberIds.size()+1
      && after.memberIds.hasAll(before.memberIds) && uid in after.memberIds
      && after.members.diff(before.members).affectedKeys().hasOnly([uid])
      && after.members.keys().size() == before.members.keys().size()+1
      && after.members.keys().hasAll(before.members.keys()) && uid in after.members;
   }
   function voteChange() {
    let before = resource.data.votes;
    let after = request.resource.data.votes;
    let keys = after.diff(before).affectedKeys();
    let key = request.resource.data.lastChange.itemId;
    let old = before.get(key, []);
    let next = after[key];
    return keys.size() == 1 && keys.hasOnly([key]) && next is list
      && key.matches('^[A-Za-z0-9_-]{1,120}$') && after.size() <= 300 && next.size() <= 20
      && next.size() == next.toSet().size()
      && next.removeAll([request.auth.uid]) == old.removeAll([request.auth.uid]);
   }
   function suggestionChange() {
    let before = resource.data.suggestions;
    let after = request.resource.data.suggestions;
    let keys = after.diff(before).affectedKeys();
    let key = request.resource.data.lastChange.itemId;
    return keys.size() == 1 && keys.hasOnly([key]) && key in after
      && key.matches('^' + request.auth.uid + '_[A-Za-z0-9_-]{1,120}$') && after.size() <= 100
      && after[key].keys().hasOnly(['by','name','itemId','change'])
      && after[key].change is map && after[key].change.size() <= 8
      && after[key].name is string && after[key].name.size() <= 40
      && after[key].by == request.auth.uid
      && (!(key in before) || before[key].by == request.auth.uid);
   }
   function contentChange() {
    let before = resource.data.get('planContent', {});
    let after = request.resource.data.planContent;
    let keys = after.diff(before).affectedKeys();
    let key = request.resource.data.lastChange.itemId;
    return keys.size() == 1 && keys.hasOnly([key]) && resource.data.locks.get(key, false) != true
      && key.matches('^[A-Za-z0-9_-]{1,120}$') && after[key] is map && after[key].size() <= 8 && after.size() <= 300;
   }
   function memberChange() {
    let keys = request.resource.data.diff(resource.data).affectedKeys();
    // Members cannot write toast text (no spoofed "Owner removed X" notices).
    return request.resource.data.lastChange.by == request.auth.uid
      && request.resource.data.lastChange.keys().hasOnly(['by','itemId']) && (
      (keys.hasOnly(['votes','lastChange']) && voteChange())
      || (keys.hasOnly(['suggestions','lastChange']) && suggestionChange())
      || (keys.hasOnly(['planContent','lastChange']) && contentChange()));
   }
   allow read: if member();
   allow create: if signed() && request.resource.data.ownerId == request.auth.uid && request.resource.data.memberIds == [request.auth.uid] && request.resource.data.members.keys() == [request.auth.uid]
     && request.resource.data.keys().hasOnly(['ownerId','ownerName','members','memberIds','inviteId','inviteExpiresAt','trip','votes','locks','suggestions','createdAt'])
     && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 40
     && tripId == 'group-' + request.resource.data.inviteId;
   allow update: if signed() && ((owner() && request.resource.data.ownerId == resource.data.ownerId) || (member() && memberChange()) || joining());
   allow delete: if owner();
  }
  // Shared per-city place-ID lists. Google Places ToS: only place IDs (plus our own category label) are stored
  // long-term; names, photos, ratings and hours are always fetched fresh. Readable by all; written by signed-in users.
  match /placeLists/{cityId} {
    allow get, list: if true;
    allow create, update: if request.auth != null
      && request.auth.token.firebase.sign_in_provider != 'anonymous'
      && cityId.matches('^[a-z0-9-]{1,80}$')
      && request.resource.data.keys().hasOnly(['city','ids','by','updatedAt'])
      && request.resource.data.keys().hasAll(['city','ids','by','updatedAt'])
      && request.resource.data.city is string && request.resource.data.city.size() <= 80
      && request.resource.data.ids is list && request.resource.data.ids.size() >= 8 && request.resource.data.ids.size() <= 40
      && request.resource.data.by == request.auth.uid
      && request.resource.data.updatedAt == request.time;
    allow delete: if false;
  }
  // Community: anyone can read public posts; only a signed-in (non-anonymous) owner writes or deletes their own.
  match /community/{postId} {
   function str(v, n) { return v is string && v.size() <= n; }
   function common(d) {
    return d.ownerId == request.auth.uid && str(d.ownerName, 40)
      && str(d.title, 80) && d.title.size() > 0 && str(d.line, 140) && str(d.destination, 80)
      && str(d.photo, 300) && (d.photo == '' || d.photo.matches('^images/[a-z-]+[.]jpg$'))
      && d.createdAt == request.time;
   }
   function tripPost(d) {
    return d.kind == 'trip'
      && d.keys().hasOnly(['kind','ownerId','ownerName','title','line','destination','photo','days','trip','createdAt'])
      && d.days is list && d.days.size() <= 21
      && d.trip is map && d.trip.keys().hasOnly(['destination','nights','start','end','answers','plan','builder'])
      && (d.trip.get('plan', null) == null || (d.trip.plan is map && d.trip.plan.days is list && d.trip.plan.days.size() <= 21))
      && postId.matches('^t_' + request.auth.uid + '_[A-Za-z0-9_-]{1,120}$');
   }
   function checkinPost(d) {
    return d.kind == 'checkin'
      && d.keys().hasOnly(['kind','ownerId','ownerName','title','line','destination','photo','place','note','createdAt'])
      && str(d.place, 80) && str(d.note, 140)
      && postId.matches('^c_' + request.auth.uid + '_[A-Za-z0-9_-]{1,40}$');
   }
   function author() { return signed() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
   allow get, list: if true;
   allow create: if author() && common(request.resource.data) && (tripPost(request.resource.data) || checkinPost(request.resource.data));
   allow update: if author() && resource.data.ownerId == request.auth.uid && common(request.resource.data) && (tripPost(request.resource.data) || checkinPost(request.resource.data));
   allow delete: if signed() && resource.data.ownerId == request.auth.uid;
  }
  // Reports are write-once and never readable from the app.
  match /reports/{reportId} {
   allow create: if signed()
     && request.resource.data.keys().hasOnly(['targetId','reason','by','at'])
     && request.resource.data.by == request.auth.uid
     && request.resource.data.reason in ['spam','inappropriate','wrong']
     && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 200
     && request.resource.data.at == request.time;
   allow read, update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
